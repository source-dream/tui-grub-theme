# One-shot line-art animation. The completed frame is held for handoff.

Window.SetBackgroundTopColor(0.031, 0.039, 0.059);
Window.SetBackgroundBottomColor(0.031, 0.039, 0.059);

screen.x = Window.GetX();
screen.y = Window.GetY();
screen.width = Window.GetWidth();
screen.height = Window.GetHeight();

frame.scale = screen.width / 2880;
frame.height_scale = screen.height / 1800;
if (frame.height_scale < frame.scale)
  frame.scale = frame.height_scale;
if (frame.scale < 0.25)
  frame.scale = 0.25;

frame.width = Math.Int(900 * frame.scale);
frame.height = Math.Int(600 * frame.scale);
frame.x = screen.x + screen.width / 2 - frame.width / 2;
frame.y = screen.y + screen.height / 2 - frame.height / 2;

frame.names[0] = "frames/frame-00.png";
frame.names[1] = "frames/frame-01.png";
frame.names[2] = "frames/frame-02.png";
frame.names[3] = "frames/frame-03.png";
frame.names[4] = "frames/frame-04.png";
frame.names[5] = "frames/frame-05.png";
frame.names[6] = "frames/frame-06.png";
frame.names[7] = "frames/frame-07.png";
frame.names[8] = "frames/frame-08.png";
frame.names[9] = "frames/frame-09.png";
frame.names[10] = "frames/frame-10.png";
frame.names[11] = "frames/frame-11.png";
frame.names[12] = "frames/frame-12.png";
frame.names[13] = "frames/frame-13.png";
frame.names[14] = "frames/frame-14.png";
frame.names[15] = "frames/frame-15.png";
frame.names[16] = "frames/frame-16.png";
frame.names[17] = "frames/frame-17.png";
frame.names[18] = "frames/frame-18.png";
frame.names[19] = "frames/frame-19.png";
frame.names[20] = "frames/frame-20.png";
frame.names[21] = "frames/frame-21.png";
frame.names[22] = "frames/frame-22.png";
frame.names[23] = "frames/frame-23.png";
frame.names[24] = "frames/frame-24.png";
frame.names[25] = "frames/frame-25.png";
frame.names[26] = "frames/frame-26.png";
frame.names[27] = "frames/frame-27.png";
frame.names[28] = "frames/frame-28.png";
frame.names[29] = "frames/frame-29.png";
frame.names[30] = "frames/frame-30.png";
frame.names[31] = "frames/frame-31.png";
frame.names[32] = "frames/frame-32.png";
frame.names[33] = "frames/frame-33.png";
frame.names[34] = "frames/frame-34.png";
frame.names[35] = "frames/frame-35.png";

fun set_frame(index)
  {
    local.source;

    source = Image(frame.names[index]);
    if (frame.width == 900 && frame.height == 600)
      frame.image = source;
    else
      frame.image = source.Scale(frame.width, frame.height);
    frame.sprite.SetImage(frame.image);
    frame.current = index;
  }

frame.source = Image(frame.names[0]);
if (frame.width == 900 && frame.height == 600)
  frame.image = frame.source;
else
  frame.image = frame.source.Scale(frame.width, frame.height);
frame.sprite = Sprite(frame.image);
frame.sprite.SetPosition(frame.x, frame.y, 10);
frame.tick = 0;
# Six refreshes per image gives the 36-frame sequence about 4.3 seconds to
# span the real boot handoff without delaying a faster boot.
frame.ticks_per_image = 6;
frame.current = 0;
frame.done = 0;
status_mode = "normal";

fun refresh_callback()
  {
    local.index;

    if (status_mode != "normal" || frame.done)
      return;

    frame.tick++;
    index = Math.Int(frame.tick / frame.ticks_per_image);
    if (index > 35)
      index = 35;
    if (index != frame.current)
      set_frame(index);
    if (index == 35)
      frame.done = 1;
  }

fun quit_callback()
  {
    if (frame.current != 35)
      set_frame(35);
    frame.sprite.SetOpacity(1);
  }

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetQuitFunction(quit_callback);

dialog.sprite = Sprite();
dialog.sprite.SetPosition(screen.x + Math.Int(72 * frame.scale), screen.y + screen.height - Math.Int(110 * frame.scale), 100);

fun display_normal_callback()
  {
    global.status_mode = "normal";
    frame.sprite.SetOpacity(1);
    dialog.sprite.SetOpacity(0);
  }

fun display_password_callback(prompt, bullets)
  {
    global.status_mode = "password";
    frame.sprite.SetOpacity(0.22);
    dialog.image = Image.Text(prompt, 0.851, 0.878, 0.933);
    dialog.sprite.SetImage(dialog.image);
    dialog.sprite.SetOpacity(1);
  }

fun display_question_callback(prompt, entry_text)
  {
    global.status_mode = "question";
    frame.sprite.SetOpacity(0.22);
    dialog.image = Image.Text(prompt, 0.851, 0.878, 0.933);
    dialog.sprite.SetImage(dialog.image);
    dialog.sprite.SetOpacity(1);
  }

fun display_message_callback(message)
  {
    dialog.image = Image.Text(message, 0.455, 0.502, 0.588);
    dialog.sprite.SetImage(dialog.image);
    dialog.sprite.SetOpacity(1);
  }

fun hide_message_callback(message)
  {
    if (status_mode == "normal")
      dialog.sprite.SetOpacity(0);
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
